# Copy this file to Backend/.env and fill in your real values.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_FILE_SIZE_MB=10

# First administrator bootstrap:
# For a NEW admin account, use an unused email and a strong password.
# For an EXISTING account, the password must match that account's current password.
# Uncomment these only when you intentionally want to bootstrap the first admin.
# INITIAL_ADMIN_EMAIL=your-admin-email@example.com
# INITIAL_ADMIN_PASSWORD=use-a-unique-strong-password
# INITIAL_ADMIN_NAME=System Administrator
